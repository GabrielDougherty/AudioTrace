<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    
    <key>CFBundleExecutable</key>
    <string>AudioTrace</string>
    
    <key>CFBundleIdentifier</key>
    <string>com.audiotrace.app</string>
    
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    
    <key>CFBundleName</key>
    <string>AudioTrace</string>
    
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    
    <key>CFBundleVersion</key>
    <string>1</string>
    
    <key>LSMinimumSystemVersion</key>
    <string>14.4</string>
    
    <key>LSUIElement</key>
    <true/>
    
    <key>NSHighResolutionCapable</key>
    <true/>
    
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    
    <!-- Audio capture permission (required for Core Audio taps on macOS 14.4+) -->
    <key>NSAudioCaptureUsageDescription</key>
    <string>AudioTrace monitors which applications are producing sound to display activity in the menu bar. No audio data is recorded or stored.</string>
    
    <!-- Accessibility permission (required for reading window titles) -->
    <key>NSAppleEventsUsageDescription</key>
    <string>AudioTrace needs accessibility access to read window titles from applications that are producing audio.</string>
    
    <!-- Application doesn't appear in Dock -->
    <key>LSBackgroundOnly</key>
    <false/>
</dict>
</plist>
